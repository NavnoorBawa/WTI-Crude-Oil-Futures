# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules

# Build outputs
dist
dist-ssr
*.local

# Frozen snapshots generated by freeze.py (regenerated fresh on every CI run)
public/data.json
public/price.json
public/research.json
public/scenario.json
data/walk_forward_NOMACRO_test.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Data files and models (if large)
*.pkl
*.h5
*.model
*.bin
models/

# Per-contract runtime state (regenerated by the pipeline on every run).
# Tracked data/ files are evidence artifacts only: walk_forward_backtest_latest.json,
# macro_leakage_test.json, eia_wti_spot_daily.json, the research artifacts.
data/CL*_*.json

# The live vol track record (backend/vol_record.py) lives on the live-data branch
# (runtime-state/vol_track_record.json); CI restores it here, never commits it to main.
data/vol_track_record.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# MacOS
.DS_Store
.AppleDouble
.LSOverride

# Temporary files
*.tmp
*.temp
temp_repo/

# Claude Code local config. The session-start hook and its settings are shared (cloud sessions
# install the dependencies with them); everything else under .claude/ stays local.
.claude/*
!.claude/settings.json
!.claude/hooks/

# Local notes (not part of the project)
GRILL_NOTES.md

# Local coverage runs (CI uploads its own report)
.coverage
.coverage.*
coverage.xml
htmlcov/
